<!DOCTYPE html>
<html lang="en">
  {{ template "head" . }}
  <body hx-ext="ws" ws-connect="/ws">
    <main class="app-shell">
      <section class="dashboard-shell">
        <header class="hero-card">
          <div class="hero-grid">
            <div>
              <p class="eyebrow">Symphony Observability</p>
              <h1 class="hero-title">Operations Dashboard</h1>
              <p class="hero-copy">
                Current state, retry pressure, token usage, and orchestration health for the active Symphony runtime.
              </p>
            </div>

            <div class="status-stack">
              <span id="ws-status" class="ws-status ws-status-connecting" data-state="connecting">
                <span class="ws-status-dot"></span>
                <span class="ws-status-label">Connecting…</span>
              </span>
              <button
                id="theme-toggle"
                class="theme-toggle"
                type="button"
                aria-label="Switch theme"
                title="Switch theme"
              >🌙</button>
              <button
                class="refresh-button"
                hx-post="/api/v1/refresh"
                hx-swap="none"
                title="Trigger an immediate poll"
              >⟳ Refresh</button>
              <div id="header-status" class="header-status">
                {{ template "header-status" . }}
              </div>
            </div>
          </div>
        </header>

        {{ if .Error }}
          <section class="error-card">
            <h2 class="error-title">Snapshot unavailable</h2>
            <p class="error-copy">
              <strong>{{ .Error.Code }}:</strong> {{ .Error.Message }}
            </p>
          </section>
        {{ else }}
          <section id="kanban" class="section-card">
            {{ template "kanban" . }}
          </section>

          <section id="metric-grid" class="metric-grid">
            {{ template "metric-grid" . }}
          </section>

          <section id="rate-limits" class="section-card">
            {{ template "rate-limits" . }}
          </section>

          <section id="running-sessions" class="section-card">
            {{ template "running-sessions" . }}
          </section>

          <section id="retrying-sessions" class="section-card">
            {{ template "retrying-sessions" . }}
          </section>
        {{ end }}
      </section>
    </main>
    {{ if .CanCreateIssue }}
      <dialog id="new-item-modal" class="new-item-modal">
        <form id="new-item-form" method="dialog">
          <h2>Create work item</h2>
          <label for="new-item-title">Title</label>
          <input id="new-item-title" name="title" type="text" maxlength="200" required />
          <label for="new-item-desc">Description (Markdown)</label>
          <textarea id="new-item-desc" name="description" rows="10"></textarea>
          <p class="new-item-modal-error" id="new-item-error"></p>
          <div class="new-item-modal-actions">
            <button type="button" data-action="cancel-new-work-item">Cancel</button>
            <button type="submit" class="primary">Create</button>
          </div>
        </form>
      </dialog>
      <script>
        (function () {
          var openBtn = document.querySelector('[data-action="open-new-work-item"]');
          var modal = document.getElementById("new-item-modal");
          var form = document.getElementById("new-item-form");
          var cancelBtn = document.querySelector('[data-action="cancel-new-work-item"]');
          var errBox = document.getElementById("new-item-error");
          if (!openBtn || !modal || !form) return;

          openBtn.addEventListener("click", function () {
            errBox.style.display = "none";
            errBox.textContent = "";
            form.reset();
            if (typeof modal.showModal === "function") {
              modal.showModal();
            }
          });
          cancelBtn.addEventListener("click", function () { modal.close(); });

          form.addEventListener("submit", function (ev) {
            ev.preventDefault();
            var title = form.elements["title"].value.trim();
            var desc = form.elements["description"].value;
            if (!title) {
              errBox.textContent = "Title is required";
              errBox.style.display = "block";
              return;
            }
            fetch("/api/v1/issues", {
              method: "POST",
              headers: {"Content-Type": "application/json"},
              body: JSON.stringify({title: title, description: desc, labels: ["dashboard"]})
            }).then(function (resp) {
              if (resp.status === 201) {
                modal.close();
                fetch("/api/v1/refresh", {method: "POST"});
                return;
              }
              return resp.json().then(function (j) {
                var msg = (j && j.error && j.error.message) || ("HTTP " + resp.status);
                errBox.textContent = msg;
                errBox.style.display = "block";
              });
            }).catch(function (err) {
              errBox.textContent = String(err);
              errBox.style.display = "block";
            });
          });
        })();
      </script>
    {{ end }}
    <script>
      // Theme toggle: flips data-theme on <html>, persists to localStorage,
      // and updates the button glyph + aria-label. Boot script in _head.tmpl
      // applies the saved theme before first paint.
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        var root = document.documentElement;
        function paint(theme) {
          if (theme === "dark") {
            btn.textContent = "☀";
            btn.setAttribute("aria-label", "Switch to light theme");
            btn.setAttribute("title", "Switch to light theme");
          } else {
            btn.textContent = "🌙";
            btn.setAttribute("aria-label", "Switch to dark theme");
            btn.setAttribute("title", "Switch to dark theme");
          }
        }
        paint(root.dataset.theme === "dark" ? "dark" : "light");
        btn.addEventListener("click", function () {
          var next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try { localStorage.setItem("symphony-theme", next); } catch (e) {}
          paint(next);
        });
      })();
    </script>
    <script>
      // Pause/Resume/Cancel button delegation. The dashboard renders new
      // button DOM on every WS fragment swap, so we delegate from the body
      // rather than attach per-button listeners.
      (function () {
        document.body.addEventListener("click", function (ev) {
          var btn = ev.target.closest("[data-action]");
          if (!btn) return;
          var action = btn.getAttribute("data-action");
          var id = btn.getAttribute("data-issue");
          if (!id) return;
          if (action === "cancel" && !window.confirm("Cancel " + id + "? This is final.")) return;
          if (action !== "pause" && action !== "resume" && action !== "cancel") return;
          fetch("/api/v1/issues/" + encodeURIComponent(id) + "/" + action, {method: "POST"})
            .then(function () { return fetch("/api/v1/refresh", {method: "POST"}); });
        });
      })();
    </script>
    <script>
      (function () {
        var pill = document.getElementById("ws-status");
        if (!pill) return;
        var label = pill.querySelector(".ws-status-label");
        var body = document.body;

        function apply(state, text) {
          pill.setAttribute("data-state", state);
          pill.className = "ws-status ws-status-" + state;
          if (label) label.textContent = text;
        }

        // Backoff schedule (ms) for reconnect attempts. After exhausting it,
        // the pill flips to "Disconnected" and stops scheduling further
        // attempts.
        var BACKOFFS = [1000, 2000, 4000, 8000, 16000, 30000];
        var MAX_FAILS = 5;
        var failCount = 0;
        var reconnectTimer = null;
        var countdownTimer = null;

        function clearTimers() {
          if (reconnectTimer) { clearTimeout(reconnectTimer); reconnectTimer = null; }
          if (countdownTimer) { clearInterval(countdownTimer); countdownTimer = null; }
        }

        function reconnect() {
          // Removing and re-adding the ws-connect attribute is the
          // htmx-supported way to force a fresh handshake.
          var url = body.getAttribute("ws-connect") || "/ws";
          body.removeAttribute("ws-connect");
          // Force htmx to re-process the body so it picks up the new attribute.
          if (window.htmx) {
            window.htmx.process(body);
          }
          setTimeout(function () {
            body.setAttribute("ws-connect", url);
            if (window.htmx) {
              window.htmx.process(body);
            }
          }, 50);
        }

        function scheduleReconnect() {
          if (failCount >= MAX_FAILS) {
            apply("disconnected", "Disconnected");
            return;
          }
          var ms = BACKOFFS[Math.min(failCount, BACKOFFS.length - 1)];
          var deadline = Date.now() + ms;
          var update = function () {
            var remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000));
            apply("disconnected", "Reconnecting in " + remaining + "s…");
          };
          update();
          countdownTimer = setInterval(update, 250);
          reconnectTimer = setTimeout(function () {
            clearTimers();
            failCount++;
            reconnect();
          }, ms);
        }

        body.addEventListener("htmx:wsOpen", function () {
          clearTimers();
          failCount = 0;
          apply("live", "Live");
        });
        body.addEventListener("htmx:wsConnecting", function () {
          if (!reconnectTimer) {
            apply("connecting", "Connecting…");
          }
        });
        body.addEventListener("htmx:wsClose", function () {
          if (reconnectTimer) return; // already scheduled
          scheduleReconnect();
        });
        body.addEventListener("htmx:wsError", function () {
          apply("error", "Connection error");
        });
      })();
    </script>
  </body>
</html>

{{ define "header-status" }}
  {{ if .Polling.Checking }}
    <span class="poll-badge poll-badge-checking" data-state="checking">
      <span class="poll-badge-dot"></span>
      Checking&nbsp;…
    </span>
  {{ else }}
    <span class="poll-badge poll-badge-idle" data-state="idle">
      <span class="poll-badge-dot"></span>
      Next poll in {{ formatNextPoll .Polling }}
    </span>
  {{ end }}
{{ end }}

{{ define "metric-grid" }}
  <article class="metric-card">
    <p class="metric-label">Running</p>
    <p class="metric-value numeric">{{ .Counts.Running }}</p>
    <p class="metric-detail">Active issue sessions in the current runtime.</p>
  </article>

  <article class="metric-card">
    <p class="metric-label">Retrying</p>
    <p class="metric-value numeric">{{ .Counts.Retrying }}</p>
    <p class="metric-detail">Issues waiting for the next retry window.</p>
  </article>

  <article class="metric-card">
    <p class="metric-label">Total tokens</p>
    <p class="metric-value numeric">{{ formatInt .AgentTotals.TotalTokens }}</p>
    <p class="metric-detail numeric">
      In {{ formatInt .AgentTotals.InputTokens }} / Out {{ formatInt .AgentTotals.OutputTokens }}
    </p>
  </article>

  <article class="metric-card">
    <p class="metric-label">Runtime</p>
    <p class="metric-value numeric">{{ formatRuntime (totalRuntimeSeconds .) }}</p>
    <p class="metric-detail">Total agent runtime across completed and active sessions.</p>
  </article>
{{ end }}

{{ define "rate-limits" }}
  <div class="section-header">
    <div>
      <h2 class="section-title">Rate limits</h2>
      <p class="section-copy">Latest upstream rate-limit snapshot, when available.</p>
    </div>
  </div>

  <pre class="code-panel">{{ prettyValue .RateLimits }}</pre>
{{ end }}

{{ define "running-sessions" }}
  <div class="section-header">
    <div>
      <h2 class="section-title">Running sessions</h2>
      <p class="section-copy">Active issues, last known agent activity, and token usage.</p>
    </div>
  </div>

  {{ if not .Running }}
    <p class="empty-state">No active sessions.</p>
  {{ else }}
    <div class="table-wrap">
      <table class="data-table data-table-running">
        <colgroup>
          <col style="width: 12rem;" />
          <col style="width: 8rem;" />
          <col style="width: 7.5rem;" />
          <col style="width: 8.5rem;" />
          <col />
          <col style="width: 10rem;" />
          <col style="width: 9rem;" />
        </colgroup>
        <thead>
          <tr>
            <th>Issue</th>
            <th>State</th>
            <th>Session</th>
            <th>Runtime / turns</th>
            <th>Agent update</th>
            <th>Tokens</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {{ range .Running }}
            <tr class="run-row {{ if eq .RunState "paused" }}run-paused{{ end }} {{ if eq .RunState "pause_requested" }}run-pausing{{ end }} {{ if eq .RunState "cancel_requested" }}run-cancelling{{ end }}">
              <td>
                <div class="issue-stack">
                  <span class="issue-id">{{ .IssueIdentifier }}</span>
                  <a class="issue-link" href="/issue/{{ .IssueIdentifier }}">Details</a>
                </div>
              </td>
              <td>
                <span class="{{ stateBadgeClass .State }}">{{ .State }}</span>
                {{ if and .RunState (ne .RunState "running") }}
                  <span class="run-state-chip run-state-{{ .RunState }}">{{ .RunState }}</span>
                {{ end }}
              </td>
              <td>
                <div class="session-stack">
                  {{ if .SessionID }}
                    <span class="mono">{{ .SessionID }}</span>
                  {{ else }}
                    <span class="muted">n/a</span>
                  {{ end }}
                </div>
              </td>
              <td class="numeric">{{ runtimeAndTurns .StartedAt .TurnCount }}</td>
              <td>
                <div class="detail-stack">
                  <span class="event-text" title="{{ or .LastMessage .LastEvent }}">{{ or .LastMessage .LastEvent "n/a" }}</span>
                  <span class="muted event-meta">
                    {{ or .LastEvent "n/a" }}
                    {{ if .LastEventAt }}
                      &middot; <span class="mono numeric">{{ .LastEventAt }}</span>
                    {{ end }}
                  </span>
                </div>
              </td>
              <td>
                <div class="token-stack numeric">
                  <span>Total: {{ formatInt .Tokens.TotalTokens }}</span>
                  <span class="muted">In {{ formatInt .Tokens.InputTokens }} / Out {{ formatInt .Tokens.OutputTokens }}</span>
                </div>
              </td>
              <td>
                <div class="run-actions">
                  {{ if eq .RunState "paused" }}
                    <button class="run-btn run-btn-resume" data-action="resume" data-issue="{{ .IssueIdentifier }}">Resume</button>
                  {{ else if eq .RunState "pause_requested" }}
                    <button class="run-btn" disabled>Pausing…</button>
                  {{ else }}
                    <button class="run-btn run-btn-pause" data-action="pause" data-issue="{{ .IssueIdentifier }}">Pause</button>
                  {{ end }}
                  <button class="run-btn run-btn-cancel" data-action="cancel" data-issue="{{ .IssueIdentifier }}">Cancel</button>
                </div>
              </td>
            </tr>
          {{ end }}
        </tbody>
      </table>
    </div>
  {{ end }}
{{ end }}

{{ define "kanban" }}
  <div class="section-header">
    <div>
      <h2 class="section-title">Kanban</h2>
      <p class="section-copy">Work items by lifecycle state.</p>
    </div>
    {{ if .CanCreateIssue }}
      <button
        class="refresh-button"
        type="button"
        data-action="open-new-work-item"
        title="Create a new work item"
      >+ New work item</button>
    {{ end }}
  </div>

  <div class="kanban-grid">
    {{ range .Kanban }}
      <div class="kanban-column" data-column="{{ .Key }}">
        <header class="kanban-column-header">
          <span class="kanban-column-title">{{ .Title }}</span>
          <span class="kanban-column-count numeric">{{ len .Cards }}</span>
        </header>
        <ul class="kanban-cards">
          {{ range .Cards }}
            <li class="kanban-card">
              {{ if and .PR (eq .PR.State "merged") }}
                <a class="kanban-card-link" href="{{ .PR.URL }}" target="_blank" rel="noopener">
                  <span class="kanban-card-id">{{ .IssueIdentifier }}</span>
                  <span class="kanban-card-title">{{ .Title }}</span>
                  <span class="kanban-card-meta mono">PR #{{ .PR.Number }} · merged</span>
                </a>
              {{ else }}
                <a class="kanban-card-link" href="/issue/{{ .IssueIdentifier }}">
                  <span class="kanban-card-id">{{ .IssueIdentifier }}</span>
                  <span class="kanban-card-title">{{ .Title }}</span>
                  {{ if .PR }}
                    <span class="kanban-card-meta mono">PR #{{ .PR.Number }} · {{ .PR.State }}</span>
                  {{ else }}
                    <span class="kanban-card-meta">{{ .State }}</span>
                  {{ end }}
                </a>
              {{ end }}
            </li>
          {{ else }}
            <li class="kanban-empty">empty</li>
          {{ end }}
        </ul>
      </div>
    {{ end }}
  </div>
{{ end }}

{{ define "retrying-sessions" }}
  <div class="section-header">
    <div>
      <h2 class="section-title">Retry queue</h2>
      <p class="section-copy">Issues waiting for the next retry window.</p>
    </div>
  </div>

  {{ if not .Retrying }}
    <p class="empty-state">No issues are currently backing off.</p>
  {{ else }}
    <div class="table-wrap">
      <table class="data-table" style="min-width: 680px;">
        <thead>
          <tr>
            <th>Issue</th>
            <th>Attempt</th>
            <th>Due at</th>
            <th>Error</th>
          </tr>
        </thead>
        <tbody>
          {{ range .Retrying }}
            <tr>
              <td>
                <div class="issue-stack">
                  <span class="issue-id">{{ .IssueIdentifier }}</span>
                  <a class="issue-link" href="/issue/{{ .IssueIdentifier }}">Details</a>
                </div>
              </td>
              <td>{{ .Attempt }}</td>
              <td class="mono">{{ or .DueAt "n/a" }}</td>
              <td>{{ or .Error "n/a" }}</td>
            </tr>
          {{ end }}
        </tbody>
      </table>
    </div>
  {{ end }}
{{ end }}
